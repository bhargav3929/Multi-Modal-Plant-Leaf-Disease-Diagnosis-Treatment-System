# Copy this file to ".env" and fill in at least ONE key (both is best: automatic failover).
# You can also paste keys in the browser via the "API Keys" button - no file editing needed.

# Primary provider (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-3.8-flash

# Fallback provider (free): https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Vision model for leaf images. Groq retires preview models from time to time;
# if this one stops working, the app automatically tries GROQ_VISION_MODEL_FALLBACK.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL_FALLBACK=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Demo quota: max AI requests (analyze + compare) per client IP per rolling hour
RATE_LIMIT_PER_HOUR=5

# Server
HOST=127.0.0.1
PORT=8001
MAX_UPLOAD_MB=8
DB_FILE=agri_pathology.db

# Only set to 1 when running behind a reverse proxy you control (reads X-Forwarded-For)
TRUST_PROXY=0
# Browser key editing is limited to localhost by default; set 1 to allow it remotely (not recommended)
ALLOW_REMOTE_KEY_EDIT=0
