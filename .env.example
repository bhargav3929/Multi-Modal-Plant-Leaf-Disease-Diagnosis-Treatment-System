# --- project ---
PROJECT_NAME=Multi-Modal Plant Leaf Disease Diagnosis & Treatment System
PROJECT_SLUG=plant-leaf
PROJECT_NUMBER=1

# --- server ---
HOST=127.0.0.1
PORT=8001
MAX_UPLOAD_MB=8

# --- AI (Groq only). Free key: https://console.groq.com/keys ---
# You can also paste the key in the app with the "API Keys" button.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_VISION_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- demo (leave as-is for the download version) ---
DEMO_MODE=false
DEMO_TICKET_SECRET=
DEMO_DAILY_CAP=200
DEMO_MAX_UPLOAD_MB=3
TRUST_PROXY=false

# --- project settings ---
DB_FILE=agri_pathology.db
